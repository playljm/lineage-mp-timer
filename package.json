{
  "name": "lineage-mp-timer",
  "version": "1.8.1",
  "description": "리니지 클래식 MP 자연회복 완충 시간 계산 + 알림 Electron 앱 (PaddleOCR 빌드)",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:portable": "electron-builder --win portable",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-distribute.ps1",
    "test": "node test/engine.test.js"
  },
  "keywords": [
    "lineage",
    "lineage-classic",
    "mp-timer",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "com.lineage.mptimer.paddle",
    "productName": "LineageMPTimerPaddle",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*",
      "node_modules/@paddlejs-models/**/*",
      "node_modules/@paddlejs/**/*",
      "node_modules/@paddlejs-mediapipe/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/tesseract.js/dist/worker.min.js",
        "to": "tesseract/worker.min.js"
      },
      {
        "from": "node_modules/tesseract.js-core",
        "to": "tesseract/core",
        "filter": [
          "tesseract-core*.wasm*",
          "tesseract-core*.js",
          "package.json"
        ]
      },
      {
        "from": "build/tessdata",
        "to": "tesseract/tessdata",
        "filter": [
          "*.traineddata*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Lineage MP Timer"
    },
    "portable": {
      "artifactName": "LineageMPTimer-${version}-portable.exe"
    }
  },
  "dependencies": {
    "@paddlejs-models/ocr": "^1.2.4",
    "tesseract.js": "^7.0.0"
  }
}
