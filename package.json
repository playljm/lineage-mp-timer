{
  "name": "lineage-mp-timer",
  "version": "3.1.6",
  "description": "리니지 클래식 MP 자연회복 완충 타이머 + EXP/아데나 트래커 (TS/Vite 리뉴얼, 바-픽셀 + 유저 디지트 템플릿 OCR)",
  "type": "module",
  "main": "out/main/index.js",
  "author": "playljm",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ocr": "vitest run test/ocr",
    "templates:user": "vitest run test/tools/build-user-templates.test.ts",
    "dist": "electron-vite build && electron-builder",
    "dist:portable": "electron-vite build && electron-builder --win portable"
  },
  "keywords": [
    "lineage",
    "lineage-classic",
    "mp-timer",
    "electron",
    "ocr"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^5.0.0",
    "pngjs": "^7.0.0",
    "pretendard": "^1.3.9",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "tesseract.js": "^7.0.0"
  },
  "build": {
    "appId": "com.lineage.mptimer",
    "productName": "LineageMPTimer",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/tesseract.js/dist/worker.min.js",
        "to": "tesseract/worker.min.js"
      },
      {
        "from": "node_modules/tesseract.js-core",
        "to": "tesseract/core",
        "filter": [
          "tesseract-core*.wasm*",
          "tesseract-core*.js",
          "package.json"
        ]
      },
      {
        "from": "build/tessdata",
        "to": "tesseract/tessdata",
        "filter": [
          "eng.traineddata*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Lineage MP Timer"
    },
    "portable": {
      "artifactName": "LineageMPTimer-${version}-portable.exe"
    }
  }
}
